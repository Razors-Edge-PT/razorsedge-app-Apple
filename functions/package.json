{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:planned-blocks": "node scripts/migrate_planned_blocks_to_users.js",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage --project rules-test \"node --test --test-concurrency=1 test-rules/rules.spec.js test-rules/coach_mode_rules.spec.js test-rules/integration.spec.js test-rules/coach_mode.spec.js test-rules/profile_showcase_rules.spec.js test-rules/profile_storage_rules.spec.js test-rules/identity_authority.spec.js test-rules/story_expiry_rules.spec.js\"",
    "migrate:usernames": "node scripts/migrate_usernames_index.js",
    "backfill:showcase": "node scripts/backfill_profile_showcase.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage --project rules-test \"node --test --test-concurrency=1 test-emulator/showcase_concurrency.spec.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
