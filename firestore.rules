rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // HELPERS
    // ======================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Only one hard-coded UID in all rules.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == "yoVAqScwLMQLAgNHh8v9IK49fBw2";
    }

    // ── Coach Mode entitlement ───────────────────────────────────────────
    // Server-owned. Coach access is a real entitlement, not a permanent
    // boolean: only state == 'active' counts, so a suspended or revoked coach
    // loses athlete access immediately even while link documents still exist.
    // `.data.get(k, default)` is used throughout so a malformed/partial
    // document denies instead of raising an evaluation error.
    function hasCoachEntitlement(uid) {
      return exists(/databases/$(database)/documents/accountEntitlements/$(uid)) &&
        get(/databases/$(database)/documents/accountEntitlements/$(uid))
          .data.get('coach', {}).get('state', '') == 'active';
    }

    // ── Canonical coach⇄athlete relationship ─────────────────────────────
    // coachAthleteLinks/{coachUid}__{athleteUid}; only 'active' is a real
    // relationship. pending / declined / cancelled / revoked_by_athlete /
    // released_by_coach all grant nothing.
    function hasActiveLink(coachUid, athleteUid) {
      return exists(/databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + athleteUid)) &&
        get(/databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + athleteUid))
          .data.get('status', '') == 'active';
    }

    // Ordinary coach authorization. No hard-coded UID list.
    //
    //   CANONICAL: an ACTIVE coach entitlement AND an ACTIVE relationship.
    //              Both are required — this is the only path new UI uses.
    //
    //   LEGACY (compatibility release only — see docs/coach_mode.md for the
    //   retirement sequence):
    //     1. a super-admin-seeded coachAssignments athletes entry (non-null).
    //        Only the super admin can create these now, so a coach can no
    //        longer seed arbitrary athletes into their own roster.
    //     2. an athleteAssignments coaches entry with approved == true.
    //        A pending / rejected / approved:false / malformed entry grants
    //        nothing.
    function isCoachFor(userId) {
      return isSignedIn() && (
        (
          hasCoachEntitlement(request.auth.uid) &&
          hasActiveLink(request.auth.uid, userId)
        )
        ||
        (
          exists(/databases/$(database)/documents/coachAssignments/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/coachAssignments/$(request.auth.uid))
            .data.athletes[userId] != null
        )
        ||
        (
          exists(/databases/$(database)/documents/athleteAssignments/$(userId)) &&
          get(/databases/$(database)/documents/athleteAssignments/$(userId))
            .data.coaches[request.auth.uid] != null &&
          get(/databases/$(database)/documents/athleteAssignments/$(userId))
            .data.coaches[request.auth.uid].approved == true
        )
      );
    }

    // Bidirectional + accepted-status check.
    // Covers the asymmetric acceptance problem: when B accepts A's invite,
    // only buddyAssignments/A.athletes.B is written. The second branch lets
    // B see A's social content despite B having no reciprocal entry.
    function isBuddyOf(ownerUid) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid))
            .data.athletes[ownerUid] != null &&
          get(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid))
            .data.athletes[ownerUid].status == 'accepted'
        )
        ||
        (
          exists(/databases/$(database)/documents/buddyAssignments/$(ownerUid)) &&
          get(/databases/$(database)/documents/buddyAssignments/$(ownerUid))
            .data.athletes[request.auth.uid] != null &&
          get(/databases/$(database)/documents/buddyAssignments/$(ownerUid))
            .data.athletes[request.auth.uid].status == 'accepted'
        )
      );
    }

    // Social visibility gate: self, confirmed friend, or super admin.
    // isCoachFor() is deliberately excluded — coach access does not bypass
    // social or media visibility.
    function isSocial(ownerUid) {
      return isSelf(ownerUid) || isBuddyOf(ownerUid) || isSuperAdmin();
    }

    // Training data gate: self, assignment-based coach, or super admin.
    function canAccessTraining(userId) {
      return isSelf(userId) || isCoachFor(userId) || isSuperAdmin();
    }


    // ======================================================
    // USERS PUBLIC (search, avatars, public stats)
    // ======================================================
    match /users_public/{userId} {
      // Any signed-in user can search / read public profiles.
      // Logged-out users cannot see any app data.
      allow read: if isSignedIn();

      // Only the owner or super admin may write (no coach write).
      allow write: if isSelf(userId) || isSuperAdmin();
    }


    // ======================================================
    // USERS PRIVATE (profile doc + subcollections)
    // ======================================================
    match /users/{userId} {
      // Private profile: self, assigned coach, or super admin.
      allow read: if isSelf(userId) || isCoachFor(userId) || isSuperAdmin();

      // Only self or super admin can write the root profile doc.
      // Coaches must not edit identity fields.
      allow write: if isSelf(userId) || isSuperAdmin();

      // ---- Lift video metadata ----
      // Social visibility only — coach is NOT a bypass here.
      match /liftVideos/{liftId} {
        allow read: if isSocial(userId);
        allow write: if isSelf(userId) || isSuperAdmin();
      }

      // ---- Buddy invite requests ----
      // users/{userId}/buddyInvites/{fromUid}
      // userId  = the receiver
      // fromUid = the sender (doc key)
      match /buddyInvites/{fromUid} {
        // Receiver (owner of userId) or super admin can read their invites.
        allow read: if isSelf(userId) || isSuperAdmin();

        // Sender creates the invite doc.
        allow create: if isSignedIn()
                      && request.auth.uid == fromUid
                      && request.resource.data.fromUid == fromUid
                      && request.resource.data.buddyUid == userId;

        // Receiver updates status (accepted / denied).
        allow update: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.fromUid == fromUid
                      && resource.data.buddyUid == userId;

        // Receiver may delete the invite doc.
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // ---- Training subcollections (workouts, blocks, etc.) ----
      // `liftVideos` is EXCLUDED: rule evaluation is a logical OR across
      // matching blocks, so without this guard the catch-all silently
      // re-granted coaches the read AND write access the liftVideos block
      // above deliberately withholds. Lift video metadata stays social-only
      // (self / confirmed buddy / super admin) — Coach Mode is not a bypass
      // for social content or media writes.
      match /{subcoll}/{doc=**} {
        allow read, write: if subcoll != 'liftVideos' && canAccessTraining(userId);
      }
    }


    // ======================================================
    // LEGACY PLANNED BLOCKS (temporary migration compatibility)
    // Canonical planned blocks now live at:
    // users/{userId}/planned_blocks/{blockId}/...
    // and are covered by the training-subcollections rule above.
    // Keep this legacy rule until old app builds and the compatibility mirror
    // have been retired.
    // ======================================================
    match /planned_blocks/{userId} {
      allow read, write: if canAccessTraining(userId);
    }
    match /planned_blocks/{userId}/{doc=**} {
      allow read, write: if canAccessTraining(userId);
    }


    // ======================================================
    // BUDDY ASSIGNMENTS
    // ======================================================
    match /buddyAssignments/{ownerUid} {
      // Only the owner or super admin can read their buddy list.
      allow read: if request.auth.uid == ownerUid || isSuperAdmin();

      // Owner or super admin may create / update / delete freely.
      // An athlete who already appears in the existing athletes map may
      // create or update (covers: accept invite, deny invite — B updating A's doc).
      // They may NOT delete the whole document.
      allow create, update: if isSignedIn() && (
        request.auth.uid == ownerUid
        || isSuperAdmin()
        || resource.data.athletes[request.auth.uid] != null
      );
      allow delete: if request.auth.uid == ownerUid || isSuperAdmin();
    }


    // ======================================================
    // POSTS
    // ======================================================
    match /posts/{postId} {
      // Read: social access only (self, confirmed friend, super admin).
      allow read: if isSocial(resource.data.ownerUid);

      // Create: only for yourself.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.ownerUid;

      // Update:
      //   - Post owner may change any field (caption edits, etc.).
      //   - Super admin may change any field.
      //   - Social visitor (friend liking / commenting) may only touch
      //     the denormalised counter fields.
      allow update: if isSelf(resource.data.ownerUid)
                    || isSuperAdmin()
                    || (
                         isSocial(resource.data.ownerUid) &&
                         request.resource.data.diff(resource.data)
                           .changedKeys()
                           .hasOnly(['likeCount', 'goodLiftCount', 'commentCount'])
                       );

      // Delete: owner or super admin only.
      allow delete: if isSelf(resource.data.ownerUid) || isSuperAdmin();
    }

    // ---- Likes: doc ID = caller UID ----
    // Only the caller may write their own like; anyone social may read.
    match /posts/{postId}/likes/{uid} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow create, update: if isSelf(uid) && isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow delete: if isSelf(uid);
    }

    // ---- GoodLifts: doc ID = caller UID ----
    match /posts/{postId}/goodLifts/{uid} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow create, update: if isSelf(uid) && isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow delete: if isSelf(uid);
    }

    // ---- Comments: auto-generated ID; uid field = author UID ----
    match /posts/{postId}/comments/{commentId} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      // Creator must set uid == their own UID and must be social.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && isSocial(
                         get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
                       );
      // Only the comment author may edit the comment body.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Author, post owner, or super admin may delete.
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isSelf(get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid)
        || isSuperAdmin()
      );
    }

    // ---- Catch-all: any unlisted post subcollection is read-only (social) ----
    match /posts/{postId}/{sub=**} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow write: if false;
    }


    // ======================================================
    // DIRECT MESSAGES
    // ======================================================
    match /conversations/{convId} {
      // isParticipant() reads resource — only valid on existing docs
      // (read / update / delete). Use request.resource for creates.
      function isParticipant() {
        return isSignedIn() && resource.data.participants[request.auth.uid] == true;
      }

      // convId = uid1_uid2 (UIDs sorted ascending, joined by "_", total 57 chars).
      // Exactly one of the two UIDs matches the caller; isBuddyOf(self) is always
      // false, so the OR resolves to the friendship check against the other person.
      function isConvFriend() {
        return isBuddyOf(convId[0:28]) || isBuddyOf(convId[29:57]);
      }

      // Read: participant + confirmed friend; super admin read-only for moderation.
      allow read: if (isParticipant() && isConvFriend()) || isSuperAdmin();

      // Create: caller must be a participant; exactly 2 participants;
      // and caller must be a confirmed friend of the other person.
      allow create: if isSignedIn()
                    && request.resource.data.participants[request.auth.uid] == true
                    && request.resource.data.participants.size() == 2
                    && isConvFriend();

      // Update: participant + still a confirmed friend.
      allow update: if isParticipant() && isConvFriend();

      // Conversations are never deleted via client.
      allow delete: if false;

      // ---- Messages subcollection ----
      match /messages/{msgId} {
        // convParticipant() must re-read the parent doc because resource here
        // is the message doc, which has no participants field.
        function convParticipant() {
          return isSignedIn() &&
            get(/databases/$(database)/documents/conversations/$(convId))
              .data.participants[request.auth.uid] == true;
        }

        // Same friend gate as the parent conversation.
        function msgConvFriend() {
          return isBuddyOf(convId[0:28]) || isBuddyOf(convId[29:57]);
        }

        allow read: if (convParticipant() && msgConvFriend()) || isSuperAdmin();
        allow create: if convParticipant() && msgConvFriend();
        // Allows reaction updates and unread-count patches by participants.
        allow update: if convParticipant() && msgConvFriend();
        allow delete: if false;
      }
    }


    // ======================================================
    // COACH / ATHLETE ASSIGNMENTS
    // ======================================================
    // LEGACY super-admin-seeded rosters. Preserved as a valid authorization
    // source, but no longer client-writable by the coach.
    //
    // SECURITY FIX: this document was previously writable by its own coach,
    // so any signed-in account could seed itself a roster of arbitrary
    // athletes — and isCoachFor() trusted any entry — granting full access to
    // those athletes' training data. Writes are now super-admin only; a coach
    // removes a seeded athlete through the coachModeRemoveSeededAthlete
    // callable, which can only ever delete an entry, never add one.
    match /coachAssignments/{coachUid} {
      allow read: if request.auth.uid == coachUid || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /athleteAssignments/{athleteUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == athleteUid
        || isSuperAdmin()
        || (
          resource.data.coaches != null &&
          resource.data.coaches[request.auth.uid] != null &&
          resource.data.coaches[request.auth.uid].approved == true
        )
      );
      // Only the athlete themselves or super admin may write.
      allow write: if request.auth.uid == athleteUid || isSuperAdmin();
    }


    // ======================================================
    // ACCESS REQUESTS (coach → athlete approval workflow)
    // ======================================================
    match /accessRequests/{requestId} {
      allow create, update: if isSignedIn()
                            && request.auth.uid == request.resource.data.coachUid;

      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.athleteUid
        || request.auth.uid == resource.data.coachUid
        || isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.athleteUid
        || isSuperAdmin()
      );
    }


    // ======================================================
    // COACH MODE (server-authoritative)
    // ======================================================
    // Every document below is written EXCLUSIVELY by Cloud Functions running
    // with Admin SDK privileges (which bypass these rules). `allow write: if
    // false` is therefore the whole write model: a client can never forge an
    // application status, an entitlement, a coach profile, a relationship or
    // an audit record.

    // ---- Coach applications: private to applicant + super admin ----
    // No coach, and no other signed-in user, can ever read someone's
    // application. Submitted through coachModeSubmitApplication; reviewed
    // through coachModeReviewApplication.
    match /coachApplications/{applicantUid} {
      allow read: if isSelf(applicantUid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Account entitlements: the authoritative Coach Mode grant ----
    // Readable by the account itself (so the client can route and show
    // suspended/revoked state) and by super admin. Never client-writable —
    // forging accountEntitlements is the only way an account could fake
    // Coach Mode, and it is closed here.
    match /accountEntitlements/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Coach profiles: limited, invitation-safe identity ----
    // Deliberately contains none of the application answers. Readable by the
    // coach, by super admin, and by an athlete who actually has a link with
    // that coach (so an invitation can name who is asking). Not a directory:
    // an unrelated signed-in user cannot read it.
    match /coachProfiles/{coachUid} {
      allow read: if isSelf(coachUid)
                  || isSuperAdmin()
                  || (isSignedIn() && exists(
                       /databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + request.auth.uid)
                     ));
      allow write: if false;
    }

    // ---- Canonical coach⇄athlete relationships ----
    // Readable only by the two parties and super admin — an unrelated signed-in
    // user cannot read relationship data. All state changes go through the
    // coachMode* callables, so a client cannot fabricate an active
    // relationship or move one between statuses.
    match /coachAthleteLinks/{linkDocId} {
      allow read: if isSignedIn() && (
        resource.data.coachUid == request.auth.uid
        || resource.data.athleteUid == request.auth.uid
        || isSuperAdmin()
      );
      allow write: if false;
    }

    // ---- Super-admin action audit ----
    match /coachAdminAudit/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }


    // ======================================================
    // EXERCISES (catalog)
    // ======================================================
    match /exercises/{doc=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }


    // ======================================================
    // COACH CHECK-INS — ANALYTICS (server-generated PB state)
    // ======================================================
    // All documents under coachAnalytics are written exclusively by Cloud
    // Functions (Admin SDK bypasses rules). Clients may only read, and only
    // through the existing training-access gate, so a revoked coach loses
    // access immediately and analytics can never be forged from a client.
    match /coachAnalytics/{athleteUid} {
      allow read: if canAccessTraining(athleteUid);
      allow write: if false;
    }
    match /coachAnalytics/{athleteUid}/{doc=**} {
      allow read: if canAccessTraining(athleteUid);
      allow write: if false;
    }

    // ======================================================
    // COACH CHECK-INS — COACH WORKSPACE (settings + reports)
    // ======================================================
    match /coachCheckIns/{coachUid} {
      // Coach-only settings doc (timezone, scheduler watermark).
      allow read: if isSelf(coachUid) || isSuperAdmin();
      // Coach may set their timezone (validated); the scheduler watermark is
      // server-set. Malformed values are rejected here and the server also
      // falls back to the default zone defensively.
      allow create, update: if (isSelf(coachUid) || isSuperAdmin())
        && request.resource.data.diff(resource == null ? {} : resource.data)
             .affectedKeys().hasOnly(['timezone', 'updatedAt'])
        && (!('timezone' in request.resource.data)
            || (request.resource.data.timezone is string
                && request.resource.data.timezone.size() > 0
                && request.resource.data.timezone.size() < 64));
      allow delete: if isSuperAdmin();

      // Per-athlete reporting settings. Coach controls ONLY the genuine
      // settings fields, ONLY for athletes they are currently assigned to
      // (a revoked coach immediately loses even read access). Server-owned
      // bookkeeping (praisedWeeks, praisedMilestones, goalSetAt,
      // lastFinalizedCoverageEnd, disabledReason/At) is unreachable, and the
      // document cannot be deleted by a normal coach — disabling reporting
      // is done via reportingEnabled.
      match /athletes/{athleteUid} {
        allow read: if (isSelf(coachUid) && isCoachFor(athleteUid)) || isSuperAdmin();
        allow create, update: if (isSuperAdmin()
          || (isSelf(coachUid) && isCoachFor(athleteUid)))
          && request.resource.data.diff(resource == null ? {} : resource.data)
               .affectedKeys().hasOnly([
                 'reportingEnabled', 'goal', 'messageExerciseMode',
                 'customExerciseIds', 'displayName', 'updatedAt', 'enabledAt'
               ])
          && (!('reportingEnabled' in request.resource.data)
              || request.resource.data.reportingEnabled is bool)
          && (!('goal' in request.resource.data)
              || request.resource.data.goal in ['cut', 'bulk', 'maintain'])
          && (!('messageExerciseMode' in request.resource.data)
              || request.resource.data.messageExerciseMode in ['automatic', 'custom'])
          && (!('customExerciseIds' in request.resource.data)
              || (request.resource.data.customExerciseIds is list
                  && request.resource.data.customExerciseIds.size() <= 100));
        allow delete: if isSuperAdmin();
      }

      // Generated checkpoint reports: read-only, and only while the coach is
      // still assigned to the report's embedded athlete (authoritative
      // athlete identity — not the caller-supplied path). All state
      // transitions (copy / undo / skip) go through callable functions so
      // coverage freezing and praise bookkeeping stay server-authoritative.
      match /reports/{reportId} {
        allow read: if (isSelf(coachUid) && isCoachFor(resource.data.athleteUid))
                    || isSuperAdmin();
        allow write: if false;
      }
    }

    // ======================================================
    // EMAIL → UID LOOKUP
    // ======================================================
    match /user_lookup/{hash} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
    }

  }
}
