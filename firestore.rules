rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // HELPERS
    // ======================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Only one hard-coded UID in all rules.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == "yoVAqScwLMQLAgNHh8v9IK49fBw2";
    }

    // ── Coach Mode entitlement ───────────────────────────────────────────
    // Server-owned. Coach access is a real entitlement, not a permanent
    // boolean: only state == 'active' counts, so a suspended or revoked coach
    // loses athlete access immediately even while link documents still exist.
    // `.data.get(k, default)` is used throughout so a malformed/partial
    // document denies instead of raising an evaluation error.
    function hasCoachEntitlement(uid) {
      return exists(/databases/$(database)/documents/accountEntitlements/$(uid)) &&
        get(/databases/$(database)/documents/accountEntitlements/$(uid))
          .data.get('coach', {}).get('state', '') == 'active';
    }

    // ── Canonical coach⇄athlete relationship ─────────────────────────────
    // coachAthleteLinks/{coachUid}__{athleteUid}; only 'active' is a real
    // relationship. pending / declined / cancelled / revoked_by_athlete /
    // released_by_coach all grant nothing.
    function linkStatus(coachUid, athleteUid) {
      return exists(/databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + athleteUid))
        ? get(/databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + athleteUid))
            .data.get('status', '')
        : '';
    }

    function hasActiveLink(coachUid, athleteUid) {
      return linkStatus(coachUid, athleteUid) == 'active';
    }

    // A canonical link recording a DELIBERATE end to the relationship. It is
    // authoritative over a stale legacy `approved` entry the link was migrated
    // from, so an athlete revocation or a coach release takes effect at once.
    function hasTerminatedLink(coachUid, athleteUid) {
      return linkStatus(coachUid, athleteUid) in
        ['declined', 'cancelled', 'revoked_by_athlete', 'released_by_coach'];
    }

    function hasSeededAssignment(coachUid, athleteUid) {
      return exists(/databases/$(database)/documents/coachAssignments/$(coachUid)) &&
        get(/databases/$(database)/documents/coachAssignments/$(coachUid))
          .data.get('athletes', {}).get(athleteUid, null) != null;
    }

    function hasLegacyApproval(coachUid, athleteUid) {
      return exists(/databases/$(database)/documents/athleteAssignments/$(athleteUid)) &&
        get(/databases/$(database)/documents/athleteAssignments/$(athleteUid))
          .data.get('coaches', {}).get(coachUid, {}).get('approved', false) == true;
    }

    // Ordinary coach authorization. No hard-coded UID list.
    //
    // An ACTIVE coach entitlement is MANDATORY for every source below. A
    // suspended, revoked, missing or malformed entitlement denies athlete
    // access outright — including when a legacy assignment exists. The legacy
    // collections may narrow WHICH athletes a coach reaches, but they can
    // never confer coach status: historically `coachAssignments` was
    // self-writable, so trusting it alone was the original vulnerability.
    //
    // Given an active entitlement, any ONE of these authorises:
    //   CANONICAL — an ACTIVE coachAthleteLinks document.
    //   LEGACY (compatibility release only — see docs/coach_mode.md §8):
    //     1. a super-admin-seeded coachAssignments athletes entry (non-null).
    //        Only the super admin can create these. NOT overridden by a
    //        terminated link — seeding is a separate admin-controlled path
    //        that this pass deliberately does not redesign.
    //     2. an athleteAssignments coaches entry with approved == true, and
    //        ONLY while no terminated canonical link exists for the pair.
    //
    // Kept logically identical to functions/coach/authz.js
    // evaluateAssignmentDetail() and to the Flutter roster composition.
    function isCoachFor(userId) {
      return isSignedIn()
        && hasCoachEntitlement(request.auth.uid)
        && (
          hasActiveLink(request.auth.uid, userId)
          || hasSeededAssignment(request.auth.uid, userId)
          || (
            hasLegacyApproval(request.auth.uid, userId)
            && !hasTerminatedLink(request.auth.uid, userId)
          )
        );
    }

    // MUTUAL accepted-status check: BOTH assignment documents must name the
    // other account as accepted.
    //
    // ── Why this is an AND, and why it used to be an OR ──────────────────
    // The original OR existed for the asymmetric acceptance problem: an older
    // accept wrote only buddyAssignments/A.athletes.B, so B needed the second
    // branch to see A's content. It had two consequences that are worse than
    // the problem it solved.
    //
    //   FORGERY. buddyAssignments/{ownerUid} lets the owner write their own
    //   document. Under the OR, any signed-in account could write
    //   `athletes.{victim} = {status:'accepted'}` into its OWN document and
    //   immediately read the victim's posts, stories, lift videos and every
    //   Storage object behind them. Friendship was self-assertable, and the
    //   whole friend-only media model rested on it.
    //
    //   UNFRIENDING DID NOT UNFRIEND. The old client-side remove deleted only
    //   the remover's entry; the other side's entry kept the OR true, so media
    //   access survived the removal.
    //
    // An AND fixes both, because an account can only ever write its own side.
    // Acceptance is what writes the second side, and buddyRespondToRequest
    // writes both in ONE transaction, so a friendship is never half-formed.
    //
    // ── The legacy pairs this changes ────────────────────────────────────
    // A genuinely-accepted pair whose reciprocal write was lost now reads as
    // not-friends. functions/scripts/symmetrise_buddy_assignments.js repairs
    // exactly those pairs and MUST be run (with --apply) BEFORE these rules
    // are deployed. No data is deleted by it; it only adds the missing side.
    function isBuddyOf(ownerUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid))
          .data.athletes[ownerUid] != null &&
        get(/databases/$(database)/documents/buddyAssignments/$(request.auth.uid))
          .data.athletes[ownerUid].status == 'accepted' &&
        exists(/databases/$(database)/documents/buddyAssignments/$(ownerUid)) &&
        get(/databases/$(database)/documents/buddyAssignments/$(ownerUid))
          .data.athletes[request.auth.uid] != null &&
        get(/databases/$(database)/documents/buddyAssignments/$(ownerUid))
          .data.athletes[request.auth.uid].status == 'accepted';
    }

    // Social visibility gate: self, confirmed friend, or super admin.
    // isCoachFor() is deliberately excluded — coach access does not bypass
    // social or media visibility.
    function isSocial(ownerUid) {
      return isSelf(ownerUid) || isBuddyOf(ownerUid) || isSuperAdmin();
    }

    // Training data gate: self, assignment-based coach, or super admin.
    function canAccessTraining(userId) {
      return isSelf(userId) || isCoachFor(userId) || isSuperAdmin();
    }

    // ── The athlete training subcollections a coach may reach ────────────
    // An explicit allowlist under users/{userId}. Everything NOT listed here
    // is unreachable by a coach — private account state (profile/membership),
    // social data (buddyInvites, posts, liftVideos, conversations), RE Points
    // caches (re_daily, re_monthly, re_cache), onboarding UI state, and any
    // subcollection added in future, which therefore fails closed.
    //
    // Inventoried from actual repository usage; keep in step with the app.
    function isTrainingSubcollection(subcoll) {
      return subcoll in [
        'workouts',                // logged training
        'weights',                 // bodyweight entries (coach analytics)
        'planned_blocks',          // CANONICAL nested planned blocks
        'block_planner',           // block planner state
        'block_data',              // per-block week/day planning data
        'plannedExerciseDetails',  // per-exercise planning detail
        'templates',               // training templates
        'customExercises'          // per-account exercise catalog
      ];
    }

    // ── Subcollections that carry their OWN write rule below ─────────────
    // Rule matches are ORed, so a subcollection left inside the users/{userId}
    // catch-all is granted everything that catch-all grants, however narrow
    // its dedicated block is. These are therefore CUT OUT of the catch-all's
    // write clause, leaving their own block as the only thing that can
    // authorise a write:
    //   showcase / showcaseDays — server-owned Big Five projection, derived
    //     from workout history by showcaseOnWorkoutWrite. A client that could
    //     write it could forge its own lifetime achievements.
    //   stories — the 24-hour window must start at the SERVER's clock, so
    //     create is constrained to publishedAt == request.time.
    // Reads are unaffected: the catch-all still gives the owner and the super
    // admin read, and each block widens reads where that is intended.
    //   socialNotifications — server-written; the owner may only mark one
    //     seen. A client that could create one could announce a friendship
    //     nobody accepted.
    function hasOwnWriteRule(subcoll) {
      return subcoll in [
        'showcase', 'showcaseDays', 'stories', 'feed', 'buddyInvites',
        'socialNotifications',
      ];
    }


    // ── Identity authority ───────────────────────────────────────────────
    // `username`, `usernameLower` and `displayName` are owned by the
    // profileChangeUsername callable, which is the ONLY writer of the
    // usernames/{sha256(name)} reservation index. A client that could write
    // these fields directly would bypass the reservation entirely, and
    // case-insensitive uniqueness would stop being a guarantee: two devices
    // can both read "free" and both write.
    //
    // ── Why this is not a flat deny ──────────────────────────────────────
    // Installed builds before 1.7.13 stamp username + usernameLower onto both
    // user documents during signup (OnboardingPageTwo/_finish via
    // buildIdentityPayloadFields). A flat deny would break account creation
    // for every one of those installs the moment these rules deployed. So
    // exactly one client identity write survives, and only until the cutoff:
    //
    //   the FIRST username on an account that has none.
    //
    // A RENAME is never a client write, at any time, in any build — that is
    // the case that can steal a name from another account, and the current
    // app already routes it through the callable.
    //
    // Every surviving legacy claim is reconciled against the reservation
    // index by identityOnPublicProfileWritten (functions/identity/reconcile.js):
    // a free name is indexed to the claimant, a name another account already
    // holds is taken back and the claimant is moved to a free variant. So the
    // compat window costs a reconciliation, never a lost uniqueness guarantee.
    //
    // ── Retiring the window ──────────────────────────────────────────────
    // Move LEGACY_IDENTITY_CLAIM_CUTOFF into the past once the pre-1.7.13
    // install base is small enough. It is a literal, not a config document,
    // so flipping it is a reviewed rules change with no extra read per write
    // and no "config document missing ⇒ fail open" hole.
    function legacyIdentityClaimWindowOpen() {
      return request.time < timestamp.date(2027, 3, 1);
    }

    function identityAffectedKeys() {
      return request.resource.data
        .diff(resource == null ? {} : resource.data)
        .affectedKeys();
    }

    function touchesIdentityFields() {
      return identityAffectedKeys()
        .hasAny(['username', 'usernameLower', 'displayName']);
    }

    // displayName is a pure server mirror of the reserved username. No client
    // build has ever written it on these documents, so it is denied outright
    // and needs no compatibility window.
    function touchesDisplayName() {
      return identityAffectedKeys().hasAny(['displayName']);
    }

    // True when the account has no username yet — the legacy SIGNUP case, as
    // opposed to a rename.
    function hasNoUsernameYet() {
      return resource == null
        || (resource.data.get('usernameLower', '') == ''
            && resource.data.get('username', '') == '');
    }

    // The same 3–22 characters, no whitespace rule the callable enforces, and
    // usernameLower must actually be the lower-cased username, so a legacy
    // claim cannot index one name while displaying another.
    function legacyUsernameShapeOk() {
      return request.resource.data.get('username', '') is string
        && request.resource.data.get('usernameLower', '') is string
        && request.resource.data.get('username', '').size() >= 3
        && request.resource.data.get('username', '').size() <= 22
        && !request.resource.data.get('username', '').matches('.*\\s.*')
        && request.resource.data.get('usernameLower', '')
             == request.resource.data.get('username', '').lower();
    }

    // A write that either leaves identity alone, or is a legal first claim
    // made by a pre-1.7.13 build inside the compatibility window.
    function identityWriteAllowed() {
      return !touchesIdentityFields()
        || (
             !touchesDisplayName()
             && hasNoUsernameYet()
             && legacyIdentityClaimWindowOpen()
             && legacyUsernameShapeOk()
           );
    }


    // ======================================================
    // USERS PUBLIC (search, avatars, public stats)
    // ======================================================
    match /users_public/{userId} {
      // Any signed-in user can search / read public profiles.
      // Logged-out users cannot see any app data.
      allow read: if isSignedIn();

      // Only the owner or super admin may write (no coach write).
      //
      // profileShowcaseV1 is EXCLUDED from the owner's write: it is the
      // presentation mirror of the server-maintained Big Five projection.
      // Leaving it writable would let any account publish achievements it
      // never performed, which is precisely what the proof-video feature is
      // meant to make meaningful. The super admin keeps full access, matching
      // the existing hard-coded super-admin behaviour elsewhere in this file.
      //
      // username / usernameLower / displayName are EXCLUDED on the same
      // principle: they are owned by the profileChangeUsername callable and
      // its reservation index, not by the client. See identityWriteAllowed()
      // for the one legacy signup write that still survives, and why.
      allow write: if isSuperAdmin()
                   || (
                        isSelf(userId)
                        && !request.resource.data
                              .diff(resource == null ? {} : resource.data)
                              .affectedKeys()
                              .hasAny(['profileShowcaseV1'])
                        && identityWriteAllowed()
                      );
    }


    // ======================================================
    // USERS PRIVATE (profile doc + subcollections)
    // ======================================================
    match /users/{userId} {
      // Private profile: self, assigned coach, or super admin.
      allow read: if isSelf(userId) || isCoachFor(userId) || isSuperAdmin();

      // Only self or super admin can write the root profile doc.
      // Coaches must not edit identity fields — and neither may the owner:
      // username / usernameLower / displayName belong to the reservation
      // service. identityWriteAllowed() keeps the one pre-1.7.13 signup write
      // alive during the compatibility window and nothing else.
      allow write: if isSuperAdmin()
                   || (isSelf(userId) && identityWriteAllowed());

      // ---- Lift video metadata ----
      // Social visibility only — coach is NOT a bypass here.
      match /liftVideos/{liftId} {
        allow read: if isSocial(userId);
        allow write: if isSelf(userId) || isSuperAdmin();
      }

      // ---- Buddy invite requests ----
      // users/{userId}/buddyInvites/{fromUid}
      // userId  = the receiver
      // fromUid = the sender (doc key)
      // 'buddyInvites' is listed in hasOwnWriteRule() so the users/{subcoll}
      // catch-all below does not re-grant the receiver unconstrained writes
      // under their own uid. It did: rule matches are ORed, so the catch-all's
      // `isSelf(userId)` write silently overrode every constraint in this
      // block — a user could create a self-request, and a receiver could
      // rewrite fromUid/buddyUid to re-address somebody else's request. Both
      // were caught by test-rules/social_buddy_rules.spec.js.
      match /buddyInvites/{fromUid} {
        // Receiver (owner of userId) or super admin can read their invites.
        allow read: if isSelf(userId) || isSuperAdmin();

        // Sender creates the invite doc.
        //
        // The doc id IS the sender's uid, so a sender cannot hold two open
        // requests to the same person however many times they tap Add.
        // fromUid != userId blocks a self-request, which would otherwise sit
        // in the receiver's own pending list and inflate their badge.
        //
        // Still a client write, deliberately: installed builds create invites
        // directly and would stop being able to send if this were denied. The
        // new client calls buddySendRequest instead, which additionally
        // rate-limits and resolves crossed requests.
        allow create: if isSignedIn()
                      && request.auth.uid == fromUid
                      && fromUid != userId
                      && request.resource.data.fromUid == fromUid
                      && request.resource.data.buddyUid == userId;

        // Receiver updates status (accepted / denied).
        //
        // Restricted to the response fields: the participants are what the
        // document path and the invite's own identity are built on, so letting
        // an update rewrite fromUid/buddyUid would let a receiver re-address
        // somebody else's request.
        allow update: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.fromUid == fromUid
                      && resource.data.buddyUid == userId
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['status', 'respondedAt']);

        // Receiver may delete the invite doc.
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // ---- Social notifications ----
      // users/{userId}/socialNotifications/{notificationId}
      //
      // "Your buddy request was accepted", written ONLY by
      // socialOnBuddyInviteWritten (functions/social/notifications.js) through
      // the Admin SDK, and only when the pair is mutually accepted.
      //
      // Read is the owner's alone — an assigned coach does not see an
      // athlete's social notices, and nobody else sees anyone's.
      //
      // The ONE client write is the owner acknowledging a notice: `seen` set to
      // true with `seenAt` at the server's clock, and nothing else changed.
      // Create and delete are denied to every client, so no device can
      // fabricate an acceptance, retarget one at another account, or plant one
      // in somebody else's collection. 'socialNotifications' is also listed in
      // hasOwnWriteRule() so the users/{subcoll} catch-all below does not
      // quietly re-grant the owner the writes this block withholds.
      match /socialNotifications/{notificationId} {
        allow read: if isSelf(userId) || isSuperAdmin();

        allow update: if isSelf(userId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['seen', 'seenAt'])
                      && request.resource.data.seen == true
                      && request.resource.data.seenAt == request.time;

        allow create, delete: if false;
      }

      // ---- Buddy feed projection ----
      // users/{userId}/feed/{ownerUid__postId}
      //
      // A per-viewer index of gallery posts by the viewer and their confirmed
      // buddies, written ONLY by feedOnPostWritten / feedOnBuddyAssignmentWritten
      // through the Admin SDK. It holds references and display metadata — post
      // id, media URLs, Storage paths, caption, timestamps — never media bytes.
      //
      // Read is the owner's alone. Write is denied to every client, including
      // the owner: a forgeable feed row is a way to put an arbitrary URL, or a
      // reference to a stranger's post, into your own feed and have the app
      // render it as a buddy's. 'feed' is also listed in hasOwnWriteRule() so
      // the users/{subcoll} catch-all below does not quietly re-grant the
      // owner the write this block withholds.
      //
      // Reading a row does NOT grant access to the media it points at. The
      // posts and Storage rules are still evaluated on their own terms, so a
      // stale row for an ex-buddy resolves to a permission denial, not to
      // content.
      match /feed/{itemId} {
        allow read: if isSelf(userId) || isSuperAdmin();
        allow write: if false;
      }

      // ---- Proof-of-record media pointers ----
      // users/{userId}/proofs/{recordFingerprint}
      // A proof attaches to the EXACT source performance (see
      // functions/showcase/reducer.js), not to a generic lift slot, so a
      // record that changes leaves its old proof behind in the gallery
      // instead of silently re-labelling new work.
      // Social visibility only — an assigned coach is NOT a bypass.
      match /proofs/{fingerprint} {
        allow read: if isSocial(userId);
        allow write: if isSelf(userId) || isSuperAdmin();
      }

      // ---- Stories (24-hour media) ----
      // Social visibility; owner-only mutation.
      //
      // The 24-hour window MUST start at the server's clock, so create
      // requires publishedAt == request.time and forbids a client-supplied
      // expiresAt (storyOnPublished stamps that from publishedAt). A client
      // cannot therefore backdate or extend a story, and an offline-selected
      // story simply never reaches this rule until it genuinely publishes.
      match /stories/{storyId} {
        // ── The 24 hours are enforced HERE, not only in the client query ────
        // A story is readable by a friend for exactly 24 hours from
        // publication. At EXACTLY publishedAt + 24h it is expired, which is
        // the same boundary isStoryLive() uses in functions/social/stories.js
        // and StoryItem.isLiveAt() uses in the app — the strict `<` is what
        // makes all three agree.
        //
        // publishedAt is pinned to request.time on create, so this measures
        // the SERVER's clock. A device with its clock moved back cannot extend
        // its own story, and a device with its clock moved forward cannot read
        // somebody else's expired one.
        //
        // Before this, expiry was purely a client-side query filter and a
        // scheduled sweep: anybody who kept the document id could read an
        // "expired" story for the up-to-an-hour gap before the sweep ran, and
        // a patched client could read it indefinitely.
        //
        // The OWNER keeps access after expiry. They need it to see and delete
        // their own story, and it is their own content — the 24 hours are a
        // promise to the audience, not a lock on the author.
        // NOTE the shape: publishedAt is compared against a value derived
        // from request.time, NOT the other way round.
        //
        // `resource.data.publishedAt + duration` is fine for a `get`, where
        // publishedAt is a concrete timestamp, but a `list` evaluates the rule
        // symbolically — publishedAt is a CONSTRAINT, and the engine refuses
        // `constraint + duration` outright ("Unsupported operation"). Written
        // this way the arithmetic is all on request.time, which is always
        // concrete, and what is left is a plain range constraint on
        // publishedAt — exactly the shape the app's watchLive() query already
        // has, so the query is provably within the rule.
        function storyIsLive() {
          return resource != null
                 && resource.data.get('publishedAt', null) != null
                 && resource.data.publishedAt >
                      request.time - duration.value(24, 'h');
        }

        // Fields a client may never write or rewrite. publishedAt and
        // expiresAt are the clock; ownerUid is who it belongs to; the paths
        // and URLs are which bytes it points at. Letting a client move any of
        // them would let it re-point a live story at somebody else's media, or
        // restart its 24 hours.
        function storyImmutablesTouched() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'publishedAt', 'expiresAt', 'ownerUid',
              'storagePath', 'thumbPath', 'url', 'thumbUrl'
            ]);
        }

        allow read: if isSelf(userId)
                    || isSuperAdmin()
                    || (isSocial(userId) && storyIsLive());

        allow create: if isSelf(userId)
                      && request.resource.data.ownerUid == userId
                      && request.resource.data.publishedAt == request.time
                      && !('expiresAt' in request.resource.data);

        // The owner may correct presentational fields only; the publication
        // clock, the owner and the media it points at are immutable once set.
        allow update: if (isSelf(userId) || isSuperAdmin())
                      && !storyImmutablesTouched();

        allow delete: if isSelf(userId) || isSuperAdmin();
      }

      // ---- Server-owned Big Five projection ----
      // Written exclusively by showcaseOnWorkoutWrite (Admin SDK bypasses
      // rules). The owner and super admin may read their own derived data;
      // the OWNER may never write it. The super admin retains write through
      // the users/{userId} catch-all below, matching the hard-coded
      // super-admin behaviour used throughout this file.
      match /showcase/{doc=**} {
        allow read: if isSelf(userId) || isSuperAdmin();
        allow write: if false;
      }
      match /showcaseDays/{doc=**} {
        allow read: if isSelf(userId) || isSuperAdmin();
        allow write: if false;
      }

      // ---- User subcollections ----
      //
      // FAIL-CLOSED. A coach reaches ONLY the explicitly listed training
      // subcollections (isTrainingSubcollection above). The owner and the
      // super admin keep full access to everything under users/{userId}.
      //
      // This replaces a blanket `canAccessTraining(userId)` catch-all. Rule
      // evaluation is a logical OR across matching blocks, so that catch-all
      // silently overrode the narrower blocks above it and handed assigned
      // coaches read AND write on:
      //   • profile/membership   — subscription state
      //   • buddyInvites         — social invitations
      //   • liftVideos           — media metadata
      // and would have done the same for every subcollection added later.
      //
      // Anything not on the training list is now unreachable by a coach by
      // default, so a NEW subcollection fails closed until it is deliberately
      // added to isTrainingSubcollection().
      //
      // The canonical nested planned blocks
      // (users/{userId}/planned_blocks/{blockId}/...) are covered by the
      // 'planned_blocks' entry plus the {doc=**} recursion.
      //
      // Subcollections listed in hasOwnWriteRule() are cut out of the WRITE
      // clause here. Because matches are ORed, leaving them in would re-grant
      // the owner unconstrained writes and quietly undo the server-owned and
      // server-clock guarantees their own blocks above exist to enforce.
      match /{subcoll}/{doc=**} {
        allow read: if isSelf(userId)
                    || isSuperAdmin()
                    || (isTrainingSubcollection(subcoll) && isCoachFor(userId));

        allow write: if isSuperAdmin()
                     || (isSelf(userId) && !hasOwnWriteRule(subcoll))
                     || (isTrainingSubcollection(subcoll) && isCoachFor(userId));
      }
    }


    // ======================================================
    // LEGACY PLANNED BLOCKS (temporary migration compatibility)
    // Canonical planned blocks now live at:
    // users/{userId}/planned_blocks/{blockId}/...
    // and are covered by the training-subcollections rule above.
    // Keep this legacy rule until old app builds and the compatibility mirror
    // have been retired.
    // ======================================================
    match /planned_blocks/{userId} {
      allow read, write: if canAccessTraining(userId);
    }
    match /planned_blocks/{userId}/{doc=**} {
      allow read, write: if canAccessTraining(userId);
    }


    // ======================================================
    // BUDDY ASSIGNMENTS
    // ======================================================
    match /buddyAssignments/{ownerUid} {
      // Only the owner or super admin can read their buddy list.
      allow read: if request.auth.uid == ownerUid || isSuperAdmin();

      // Only the owner or super admin may bring this document into existence.
      // The non-owner branch below is an UPDATE rule: it is reached only when
      // the caller already appears in an existing athletes map, which cannot
      // be true on a create.
      allow create: if isSignedIn() && (
        request.auth.uid == ownerUid || isSuperAdmin()
      );

      // Owner or super admin may update freely.
      //
      // An athlete who already appears in the athletes map may update too —
      // that is the legacy accept/deny path, where B writes `athletes.B` in
      // A's document — but ONLY their own entry.
      //
      // Without the diff clause that branch let anyone already inside A's map
      // rewrite the WHOLE map: B could add C as accepted in A's document, and
      // C could accept A in C's own, manufacturing a friendship between A and
      // C that neither of them agreed to. Restricting the write to the single
      // key named by the caller keeps the legacy flows working — both of them
      // touch exactly `athletes.{self}` — while removing the forgery.
      allow update: if isSignedIn() && (
        request.auth.uid == ownerUid
        || isSuperAdmin()
        || (
          resource.data.athletes[request.auth.uid] != null
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['athletes'])
          && request.resource.data.athletes.diff(resource.data.athletes)
               .affectedKeys().hasOnly([request.auth.uid])
        )
      );

      allow delete: if request.auth.uid == ownerUid || isSuperAdmin();
    }


    // ======================================================
    // BUDDY DISCOVERY: SEARCH PROJECTION
    // ======================================================
    // userSearchIndex/{uid}
    //
    // The only collection buddy search reads. Maintained from users_public by
    // searchIndexOnPublicProfileWritten (functions/social/search_index.js) and
    // by nothing else.
    //
    // It carries only what is safe for one signed-in stranger to see about
    // another: uid, username, display name, published full name, derived first
    // and last name, a small avatar URL, and the match tokens. No email, no
    // phone, no date of birth, no entitlement or billing state, no coach
    // relationship, no training data. The legacy search queried users_public
    // by emailLower and handed the matched email back to the client; this
    // projection exists so that stops being possible.
    //
    // Writes are denied outright. The Admin SDK bypasses rules, so the
    // maintenance function is unaffected, while a client cannot make itself
    // findable under someone else's name or inject terms it does not own.
    match /userSearchIndex/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }


    // ======================================================
    // CONFIRMED-FRIEND PROJECTION
    // ======================================================
    // socialGraph/{uid}.friends
    //
    // The precomputed intersection of both buddyAssignments documents — the
    // accounts that have accepted each other. A PROJECTION, never an
    // authority: no rule in this file reads it, and deleting it would change
    // nothing about what is permitted. isBuddyOf() still reads the assignment
    // documents themselves.
    //
    // It exists because a confirmed friendship is mutual and buddyAssignments
    // is owner-read-only, so a client cannot see the other side and therefore
    // cannot tell a real friendship from one it merely claims. Owner-read,
    // server-write, for exactly that reason: a client-writable friend list
    // would put the answer back in the client's hands.
    match /socialGraph/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if false;
    }


    // ======================================================
    // SOCIAL RATE LIMITS
    // ======================================================
    // socialRateLimits/{uid}
    //
    // The buddy-request budget consumed by buddySendRequest. Denied to clients
    // in both directions and stated explicitly rather than left to the default
    // deny: a counter a device could read would tell an abuser exactly how
    // much room is left, and one it could write would not be a limit at all.
    match /socialRateLimits/{uid} {
      allow read, write: if false;
    }


    // ======================================================
    // POSTS
    // ======================================================
    match /posts/{postId} {
      // Read: social access only (self, confirmed friend, super admin).
      allow read: if isSocial(resource.data.ownerUid);

      // Create: only for yourself.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.ownerUid;

      // Update:
      //   - Post owner may change any field (caption edits, etc.).
      //   - Super admin may change any field.
      //   - Social visitor (friend liking / commenting) may only touch
      //     the denormalised counter fields.
      allow update: if isSelf(resource.data.ownerUid)
                    || isSuperAdmin()
                    || (
                         isSocial(resource.data.ownerUid) &&
                         request.resource.data.diff(resource.data)
                           .changedKeys()
                           .hasOnly(['likeCount', 'goodLiftCount', 'commentCount'])
                       );

      // Delete: owner or super admin only.
      allow delete: if isSelf(resource.data.ownerUid) || isSuperAdmin();
    }

    // ---- Likes: doc ID = caller UID ----
    // Only the caller may write their own like; anyone social may read.
    match /posts/{postId}/likes/{uid} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow create, update: if isSelf(uid) && isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow delete: if isSelf(uid);
    }

    // ---- GoodLifts: doc ID = caller UID ----
    match /posts/{postId}/goodLifts/{uid} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow create, update: if isSelf(uid) && isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow delete: if isSelf(uid);
    }

    // ---- Comments: auto-generated ID; uid field = author UID ----
    match /posts/{postId}/comments/{commentId} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      // Creator must set uid == their own UID and must be social.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && isSocial(
                         get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
                       );
      // Only the comment author may edit the comment body.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Author, post owner, or super admin may delete.
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isSelf(get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid)
        || isSuperAdmin()
      );
    }

    // ---- Catch-all: any unlisted post subcollection is read-only (social) ----
    match /posts/{postId}/{sub=**} {
      allow read: if isSocial(
        get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
      );
      allow write: if false;
    }


    // ======================================================
    // DIRECT MESSAGES
    // ======================================================
    match /conversations/{convId} {
      // isParticipant() reads resource — only valid on existing docs
      // (read / update / delete). Use request.resource for creates.
      function isParticipant() {
        return isSignedIn() && resource.data.participants[request.auth.uid] == true;
      }

      // convId = uid1_uid2 (UIDs sorted ascending, joined by "_", total 57 chars).
      // Exactly one of the two UIDs matches the caller; isBuddyOf(self) is always
      // false, so the OR resolves to the friendship check against the other person.
      function isConvFriend() {
        return isBuddyOf(convId[0:28]) || isBuddyOf(convId[29:57]);
      }

      // ── The unread ledger is the server's ──────────────────────────────
      // participantState.{uid}.incoming counts the deliverable messages sent
      // TO that person, and is written only by the DM trigger
      // (functions/push/dm_unread.js). A client that could move it could
      // inflate the other person's badge, or silently hide messages from
      // them, and could make the delivery worker skip a real message as
      // "already read". Clients still own their own `readIncoming`,
      // `lastReadAt` and the legacy `unreadCount`.
      function incomingOf(data, uid) {
        return data.get('participantState', {}).get(uid, {}).get('incoming', 0);
      }

      function ledgerUnchanged(uid) {
        return incomingOf(request.resource.data, uid) == incomingOf(resource.data, uid);
      }

      // Read: participant + confirmed friend; super admin read-only for moderation.
      allow read: if (isParticipant() && isConvFriend()) || isSuperAdmin();

      // Create: caller must be a participant; exactly 2 participants;
      // and caller must be a confirmed friend of the other person.
      //
      // The participants must be EXACTLY the two accounts the id names, both
      // `true`. Push delivery and the Storage dm/ rules both read this map to
      // decide who a message is for; a map naming a third account (or omitting
      // the other one) would address a conversation to the wrong person.
      allow create: if isSignedIn()
                    && request.resource.data.participants[request.auth.uid] == true
                    && request.resource.data.participants.size() == 2
                    && convId.size() == 57
                    && convId[28:29] == '_'
                    && request.resource.data.participants.keys()
                         .hasAll([convId[0:28], convId[29:57]])
                    && request.resource.data.participants[convId[0:28]] == true
                    && request.resource.data.participants[convId[29:57]] == true
                    && incomingOf(request.resource.data, convId[0:28]) == 0
                    && incomingOf(request.resource.data, convId[29:57]) == 0
                    && isConvFriend();

      // Update: participant + still a confirmed friend — and never the
      // participants themselves. Before this, either participant could rewrite
      // the map, e.g. add one of their own friends, who would then satisfy
      // isParticipant() and isConvFriend() and read the whole thread. Every
      // app write (lastMessage, updatedAt, participantState, and the merge-set
      // bootstrap that repeats the SAME map) leaves `participants` unchanged.
      allow update: if isParticipant() && isConvFriend()
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['participants'])
                    && ledgerUnchanged(convId[0:28])
                    && ledgerUnchanged(convId[29:57]);

      // Conversations are never deleted via client.
      allow delete: if false;

      // ---- Messages subcollection ----
      match /messages/{msgId} {
        // convParticipant() must re-read the parent doc because resource here
        // is the message doc, which has no participants field.
        function convParticipant() {
          return isSignedIn() &&
            get(/databases/$(database)/documents/conversations/$(convId))
              .data.participants[request.auth.uid] == true;
        }

        // Same friend gate as the parent conversation.
        function msgConvFriend() {
          return isBuddyOf(convId[0:28]) || isBuddyOf(convId[29:57]);
        }

        allow read: if (convParticipant() && msgConvFriend()) || isSuperAdmin();

        // Create: the sender is the caller. Every installed build writes
        // `senderId: <own uid>`; binding it here means a participant cannot
        // post a message as the other person — which push delivery would
        // otherwise announce to that person's friend under the wrong name.
        // `incomingSeq` is the recipient's ledger position, stamped by the DM
        // trigger. A client-supplied one would let a sender pick the other
        // person's unread number.
        allow create: if convParticipant() && msgConvFriend()
                      && request.resource.data.senderId == request.auth.uid
                      && !('incomingSeq' in request.resource.data);

        // Update: `senderId` is immutable. The SENDER may complete their own
        // message (the photo/video URL attached after upload); anyone else in
        // the conversation may only react. Those are the only message updates
        // any build has ever made. Without this, the other participant could
        // attach media to an empty upload shell and have it delivered as the
        // sender's.
        allow update: if convParticipant() && msgConvFriend()
                      && !request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny(['senderId', 'incomingSeq'])
                      && (
                           resource.data.get('senderId', '') == request.auth.uid
                           || request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['reactions'])
                         );
        allow delete: if false;
      }
    }


    // ======================================================
    // COACH / ATHLETE ASSIGNMENTS
    // ======================================================
    // LEGACY super-admin-seeded rosters. Preserved as a valid authorization
    // source, but no longer client-writable by the coach.
    //
    // SECURITY FIX: this document was previously writable by its own coach,
    // so any signed-in account could seed itself a roster of arbitrary
    // athletes — and isCoachFor() trusted any entry — granting full access to
    // those athletes' training data. Writes are now super-admin only; a coach
    // removes a seeded athlete through the coachModeRemoveSeededAthlete
    // callable, which can only ever delete an entry, never add one.
    match /coachAssignments/{coachUid} {
      allow read: if request.auth.uid == coachUid || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /athleteAssignments/{athleteUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == athleteUid
        || isSuperAdmin()
        || (
          resource.data.coaches != null &&
          resource.data.coaches[request.auth.uid] != null &&
          resource.data.coaches[request.auth.uid].approved == true
        )
      );
      // Only the athlete themselves or super admin may write.
      allow write: if request.auth.uid == athleteUid || isSuperAdmin();
    }


    // ======================================================
    // ACCESS REQUESTS (coach → athlete approval workflow)
    // ======================================================
    match /accessRequests/{requestId} {
      allow create, update: if isSignedIn()
                            && request.auth.uid == request.resource.data.coachUid;

      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.athleteUid
        || request.auth.uid == resource.data.coachUid
        || isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.athleteUid
        || isSuperAdmin()
      );
    }


    // ======================================================
    // COACH MODE (server-authoritative)
    // ======================================================
    // Every document below is written EXCLUSIVELY by Cloud Functions running
    // with Admin SDK privileges (which bypass these rules). `allow write: if
    // false` is therefore the whole write model: a client can never forge an
    // application status, an entitlement, a coach profile, a relationship or
    // an audit record.

    // ---- Coach applications: private to applicant + super admin ----
    // No coach, and no other signed-in user, can ever read someone's
    // application. Submitted through coachModeSubmitApplication; reviewed
    // through coachModeReviewApplication.
    match /coachApplications/{applicantUid} {
      allow read: if isSelf(applicantUid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Account entitlements: the authoritative Coach Mode grant ----
    // Readable by the account itself (so the client can route and show
    // suspended/revoked state) and by super admin. Never client-writable —
    // forging accountEntitlements is the only way an account could fake
    // Coach Mode, and it is closed here.
    match /accountEntitlements/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Coach profiles: limited, invitation-safe identity ----
    // Deliberately contains none of the application answers. Readable by the
    // coach, by super admin, and by an athlete who actually has a link with
    // that coach (so an invitation can name who is asking). Not a directory:
    // an unrelated signed-in user cannot read it.
    match /coachProfiles/{coachUid} {
      allow read: if isSelf(coachUid)
                  || isSuperAdmin()
                  || (isSignedIn() && exists(
                       /databases/$(database)/documents/coachAthleteLinks/$(coachUid + '__' + request.auth.uid)
                     ));
      allow write: if false;
    }

    // ---- Canonical coach⇄athlete relationships ----
    // Readable only by the two parties and super admin — an unrelated signed-in
    // user cannot read relationship data. All state changes go through the
    // coachMode* callables, so a client cannot fabricate an active
    // relationship or move one between statuses.
    match /coachAthleteLinks/{linkDocId} {
      allow read: if isSignedIn() && (
        resource.data.coachUid == request.auth.uid
        || resource.data.athleteUid == request.auth.uid
        || isSuperAdmin()
      );
      allow write: if false;
    }

    // ---- Super-admin action audit ----
    match /coachAdminAudit/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }


    // ======================================================
    // EXERCISES (catalog)
    // ======================================================
    match /exercises/{doc=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }


    // ======================================================
    // COACH CHECK-INS — ANALYTICS (server-generated PB state)
    // ======================================================
    // All documents under coachAnalytics are written exclusively by Cloud
    // Functions (Admin SDK bypasses rules). Clients may only read, and only
    // through the existing training-access gate, so a revoked coach loses
    // access immediately and analytics can never be forged from a client.
    match /coachAnalytics/{athleteUid} {
      allow read: if canAccessTraining(athleteUid);
      allow write: if false;
    }
    match /coachAnalytics/{athleteUid}/{doc=**} {
      allow read: if canAccessTraining(athleteUid);
      allow write: if false;
    }

    // ======================================================
    // COACH CHECK-INS — COACH WORKSPACE (settings + reports)
    // ======================================================
    match /coachCheckIns/{coachUid} {
      // Coach-only settings doc (timezone, scheduler watermark).
      allow read: if isSelf(coachUid) || isSuperAdmin();
      // Coach may set their timezone (validated); the scheduler watermark is
      // server-set. Malformed values are rejected here and the server also
      // falls back to the default zone defensively.
      allow create, update: if (isSelf(coachUid) || isSuperAdmin())
        && request.resource.data.diff(resource == null ? {} : resource.data)
             .affectedKeys().hasOnly(['timezone', 'updatedAt'])
        && (!('timezone' in request.resource.data)
            || (request.resource.data.timezone is string
                && request.resource.data.timezone.size() > 0
                && request.resource.data.timezone.size() < 64));
      allow delete: if isSuperAdmin();

      // Per-athlete reporting settings. Coach controls ONLY the genuine
      // settings fields, ONLY for athletes they are currently assigned to
      // (a revoked coach immediately loses even read access). Server-owned
      // bookkeeping (praisedWeeks, praisedMilestones, goalSetAt,
      // lastFinalizedCoverageEnd, disabledReason/At) is unreachable, and the
      // document cannot be deleted by a normal coach — disabling reporting
      // is done via reportingEnabled.
      match /athletes/{athleteUid} {
        allow read: if (isSelf(coachUid) && isCoachFor(athleteUid)) || isSuperAdmin();
        allow create, update: if (isSuperAdmin()
          || (isSelf(coachUid) && isCoachFor(athleteUid)))
          && request.resource.data.diff(resource == null ? {} : resource.data)
               .affectedKeys().hasOnly([
                 'reportingEnabled', 'goal', 'messageExerciseMode',
                 'customExerciseIds', 'displayName', 'updatedAt', 'enabledAt'
               ])
          && (!('reportingEnabled' in request.resource.data)
              || request.resource.data.reportingEnabled is bool)
          && (!('goal' in request.resource.data)
              || request.resource.data.goal in ['cut', 'bulk', 'maintain'])
          && (!('messageExerciseMode' in request.resource.data)
              || request.resource.data.messageExerciseMode in ['automatic', 'custom'])
          && (!('customExerciseIds' in request.resource.data)
              || (request.resource.data.customExerciseIds is list
                  && request.resource.data.customExerciseIds.size() <= 100));
        allow delete: if isSuperAdmin();
      }

      // Generated checkpoint reports: read-only, and only while the coach is
      // still assigned to the report's embedded athlete (authoritative
      // athlete identity — not the caller-supplied path). All state
      // transitions (copy / undo / skip) go through callable functions so
      // coverage freezing and praise bookkeeping stay server-authoritative.
      match /reports/{reportId} {
        allow read: if (isSelf(coachUid) && isCoachFor(resource.data.athleteUid))
                    || isSuperAdmin();
        allow write: if false;
      }
    }

    // ======================================================
    // USERNAME UNIQUENESS INDEX
    // ======================================================
    // usernames/{sha256(normalisedName)} → { uid, username, usernameLower }
    //
    // The document id is a HASH, not the name: a username may legally contain
    // '/', '.' or '..', none of which are safe as a Firestore document id.
    //
    // Written exclusively by the profileChangeUsername callable, inside one
    // transaction that reserves the new key, releases the old one and updates
    // both user documents. A client "query then write" can never be race-free,
    // so client writes are refused outright here — that refusal is what makes
    // case-insensitive uniqueness an actual guarantee rather than a hope.
    //
    // Signed-in read is allowed so the app can check availability with a
    // single document get. It exposes no more than the existing
    // users_public usernameLower query already does.
    match /usernames/{indexKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }


    // ======================================================
    // PUSH NOTIFICATIONS
    // ======================================================
    // Three notifications only: friend request, request accepted, direct
    // message. Delivery is entirely server-side (functions/push/outbox.js);
    // no device ever sends a push or reads another account's registrations.
    // Top-level collections on purpose: nothing under users/{userId} — and so
    // none of that block's catch-all grants — can reach them.

    // ---- Registrations: pushDevices/{sha256(token)} ----
    // One document per FCM token, its id bound to the token by hash, so a
    // token has exactly ONE owning account. Signing into another account on
    // the same phone re-registers the same token and takes the document over;
    // it cannot end up delivering both accounts' notifications.
    //
    // The owner reads and deletes their own. A write must name the caller as
    // owner and stamp the server clock (the freshness the server prunes on).
    // Taking over an existing document requires presenting the SAME token —
    // i.e. being the device that holds it.
    match /pushDevices/{deviceId} {
      function validRegistration() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'token', 'platform', 'appVersion', 'updatedAt'])
          && d.keys().hasAll(['uid', 'token', 'platform', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.token is string
          && d.token.size() > 0
          && d.token.size() <= 4096
          && deviceId == hashing.sha256(d.token).toHexString().lower()
          && d.platform in ['android', 'ios']
          && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 40))
          && d.updatedAt == request.time;
      }

      allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && validRegistration();
      allow update: if isSignedIn() && validRegistration()
                    && request.resource.data.token == resource.data.token;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Preferences: pushPreferences/{uid} ----
    // The account's own switches, and nobody else's: not an assigned coach
    // (Coach Mode never acts on an athlete's social account), not the super
    // admin. Every field is optional; the server defaults missing categories
    // to ON and message previews to OFF.
    match /pushPreferences/{uid} {
      function validPreferences() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'friendRequests', 'friendAccepted', 'directMessages',
            'messagePreviews', 'updatedAt'
          ])
          && (!('friendRequests' in d) || d.friendRequests is bool)
          && (!('friendAccepted' in d) || d.friendAccepted is bool)
          && (!('directMessages' in d) || d.directMessages is bool)
          && (!('messagePreviews' in d) || d.messagePreviews is bool)
          && d.updatedAt == request.time;
      }

      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validPreferences();
      allow delete: if isSelf(uid);
    }

    // ---- Delivery jobs and the kill switch: server only ----
    // A readable outbox would reveal who is messaging whom; a writable one
    // would let a device push arbitrary alerts to anybody.
    match /pushOutbox/{jobId} {
      allow read, write: if false;
    }
    match /pushConfig/{docId} {
      allow read, write: if false;
    }


    // ======================================================
    // EMAIL → UID LOOKUP
    // ======================================================
    match /user_lookup/{hash} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
    }

  }
}
